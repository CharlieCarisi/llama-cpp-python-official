name: Build Release

on:
  workflow_dispatch:
    inputs:
      version_tag:
        description: "Release tag, e.g. v0.3.2-test1"
        required: true
        default: "v0.3.2-custom"

permissions:
  contents: write

jobs:
  build_wheels:
    name: Build Windows cp39 wheel
    runs-on: windows-2019

    steps:
      - uses: actions/checkout@v4
        with:
          submodules: "recursive"

      - uses: actions/setup-python@v5
        with:
          python-version: "3.9"

      - name: Install build dependencies
        shell: cmd
        run: |
          python -m pip install --upgrade "pip<26"
          python -m pip install uv
          python -m uv pip install -e .[all] --verbose

      - name: Build Windows cp39 wheel
        uses: pypa/cibuildwheel@v2.21.1
        env:
          CIBW_BUILD: "cp39-win_amd64"
          CIBW_SKIP: "*musllinux* pp*"
          CIBW_REPAIR_WHEEL_COMMAND: ""
        with:
          package-dir: .
          output-dir: wheelhouse

      - uses: actions/upload-artifact@v4
        with:
          name: wheels-windows-cp39
          path: ./wheelhouse/*.whl

  release:
    name: Release
    needs: [build_wheels]
    runs-on: ubuntu-latest

    steps:
      - uses: actions/download-artifact@v4
        with:
          merge-multiple: true
          path: dist

      - uses: softprops/action-gh-release@v2
        with:
          tag_name: ${{ github.event.inputs.version_tag }}
          name: ${{ github.event.inputs.version_tag }}
          files: dist/*
        env:
          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}
